# ==============================================================================
# UdyamNiti Local Development Environment Configuration
# ==============================================================================
# Copy this file to .env before starting containers:
#   cp .env.example .env
#
# NOTE: Safe defaults are provided for local Docker development.
# ZERO secrets are committed here. No real production keys are included.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django API & Security
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=hackathon-dev-secret-key-udyamniti-super-secure-change-in-prod
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend,web

# CORS & CSRF Configuration (allows React frontend on port 3000 & 5173)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# ------------------------------------------------------------------------------
# 2. PostgreSQL + pgvector Database
# ------------------------------------------------------------------------------
POSTGRES_DB=udyamniti
POSTGRES_USER=udyamniti
POSTGRES_PASSWORD=udyamniti_secret
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://udyamniti:udyamniti_secret@db:5432/udyamniti

# ------------------------------------------------------------------------------
# 3. Redis Cache & Celery Message Broker
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. Google Gemini AI API (Optional for Demo)
# ------------------------------------------------------------------------------
# If left blank or invalid, the backend automatically uses intelligent
# deterministic mock responses so judges can run the entire platform offline!
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. S3-Compatible MinIO Storage (Document Verification)
# ------------------------------------------------------------------------------
# Toggle to true to store uploaded MSME documents in local MinIO bucket
USE_S3=false
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_STORAGE_BUCKET_NAME=udyamniti-documents

# ------------------------------------------------------------------------------
# 6. Frontend Configuration
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_MOCK_FALLBACK=true

# ------------------------------------------------------------------------------
# 7. Logging & Observability
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
ENABLE_STRUCTURED_JSON_LOGGING=true
